# Copy to .env and fill in real values before `docker compose up`.

# --- RDS Postgres (shared with the live core-dev/backbone-dev EKS clusters) ---
DB_HOST=selco-prod-db.c1yks4g2c2zp.ap-south-1.rds.amazonaws.com
DB_NAME=selcodevuatdb
DB_USERNAME=
DB_PASSWORD=

# --- Kafka (single-node KRaft, generate your own with `kafka-storage.sh random-uuid`) ---
KAFKA_KRAFT_CLUSTER_ID=Mk3OEYBSD34fcwNTJENDM2Qk

# egov-enc-service encryption master IV
ENC_MASTER_INITIALVECTOR=
# egov-enc-service encryption master password
ENC_MASTER_PASSWORD=
# egov-enc-service encryption master salt
ENC_MASTER_SALT=
# Elasticsearch xpack security password (elastic superuser). Change this.
ES_PASSWORD=changeme
# Elasticsearch xpack security username
ES_USERNAME=elastic
# S3 access key used by egov-filestore
FILESTORE_AWS_KEY=
# S3 secret key used by egov-filestore
FILESTORE_AWS_SECRETKEY=
# Google Maps API key used by egov-location
LOCATION_GMAPS_KEY=
# SMTP password for egov-notification-mail
NOTIFICATION_MAIL_PASSWORD=
# SMTP username for egov-notification-mail
NOTIFICATION_MAIL_USERNAME=
# SMS gateway password for egov-notification-sms
NOTIFICATION_SMS_PASSWORD=
# SMS gateway username for egov-notification-sms
NOTIFICATION_SMS_USERNAME=
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
# Gemini API key used by the translator service
TRANSLATOR_GEMINI_API_KEY=
# Generate using elasticsearch-service-tokens create elastic/kibana kibana-token
KIBANA_SERVICE_TOKEN=
